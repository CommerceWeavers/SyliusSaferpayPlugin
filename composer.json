{
    "name": "commerce-weavers/sylius-saferpay-plugin",
    "description": "Integration with Worldline Saferpay for Sylius",
    "type": "sylius-plugin",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "worldline",
        "saferpay",
        "payment",
        "payment-gateway"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "payum/core": "^1.7",
        "sylius/core-bundle": "^2.0",
        "sylius/payum-bundle": "^2.0",
        "sylius/resource-bundle": "^1.12",
        "sylius/ui-bundle": "^2.0",
        "symfony/clock": "^6.4 || ^7.4",
        "symfony/http-client": "^6.4 || ^7.4",
        "symfony/lock": "^6.4 || ^7.4",
        "symfony/messenger": "^6.4 || ^7.4",
        "symfony/uid": "^6.4 || ^7.4"
    },
    "require-dev": {
        "behat/behat": "^3.16",
        "behat/mink-selenium2-driver": "^1.7",
        "dmore/behat-chrome-extension": "^1.4",
        "dmore/chrome-mink-driver": "^2.9",
        "friends-of-behat/mink": "^1.11",
        "friends-of-behat/mink-browserkit-driver": "^1.6",
        "friends-of-behat/mink-debug-extension": "^2.1",
        "friends-of-behat/mink-extension": "^2.7",
        "friends-of-behat/page-object-extension": "^0.3.2",
        "friends-of-behat/suite-settings-extension": "^1.1",
        "friends-of-behat/symfony-extension": "^2.6",
        "friends-of-behat/variadic-extension": "^1.6",
        "lchrusciel/api-test-case": "^6.0",
        "matthiasnoback/symfony-config-test": "^6.0",
        "matthiasnoback/symfony-dependency-injection-test": "^6.0",
        "nyholm/psr7": "^1.8",
        "phpspec/phpspec": "^7.5 || ^8.0",
        "phpspec/prophecy-phpunit": "^2.3",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^11.5",
        "polishsymfonycommunity/symfony-mocker-container": "^1.0",
        "robertfausk/behat-panther-extension": "^1.1",
        "sylius-labs/coding-standard": "^4.4",
        "sylius/sylius": "^2.0",
        "symfony/browser-kit": "^6.4 || ^7.4",
        "symfony/debug-bundle": "^6.4 || ^7.4",
        "symfony/dotenv": "^6.4 || ^7.4",
        "symfony/flex": "^2.4",
        "symfony/intl": "^6.4 || ^7.4",
        "symfony/panther": "^2.1",
        "symfony/runtime": "^6.4 || ^7.4",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4",
        "symfony/webpack-encore-bundle": "^2.0",
        "theofidry/alice-data-fixtures": "^1.7",
        "winzou/state-machine-bundle": "^0.6"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/thanks": false,
            "symfony/runtime": true,
            "php-http/discovery": false
        }
    },
    "extra": {
        "symfony": {
            "require": "7.4.*"
        }
    },
    "autoload": {
        "psr-4": {
            "CommerceWeavers\\SyliusSaferpayPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "spec\\CommerceWeavers\\SyliusSaferpayPlugin\\": "spec/",
            "Tests\\CommerceWeavers\\SyliusSaferpayPlugin\\": "tests/",
            "Tests\\CommerceWeavers\\SyliusSaferpayPlugin\\Application\\": "tests/Application/src/"
        }
    },
    "scripts": {
        "behat": "APP_ENV=test vendor/bin/behat --format=progress --colors --strict -vvv --no-interaction --tags=\"~@todo\"",
        "ecs": "ecs",
        "ecs-fix": "ecs --fix",
        "phpunit": "phpunit",
        "phpstan": "phpstan",
        "phpspec": "phpspec run",
        "ci": [
            "@static-analysis",
            "@phpunit",
            "@phpspec"
        ],
        "static-analysis": [
            "@phpstan",
            "@ecs"
        ],
        "githooks:install": "cp -f etc/git-hooks/pre-commit .git/hooks/pre-commit",
        "post-install-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-update-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-create-project-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "security-checker security:check": "script"
        }
    }
}
